shamefullyHoist: true
shellEmulator: true
strictPeerDependencies: false
autoInstallPeers: false
dangerouslyAllowAllBuilds: true
packages: []
catalogs:
  build:
    '@nuxt/devtools': ^3.3.1
    '@nuxt/eslint': ^1.16.0
    '@nuxt/kit': ^4.4.2
    '@nuxtjs/color-mode': ^4.0.1
    '@pinia/nuxt': ^0.11.3
    '@vite-pwa/nuxt': ^1.1.1
    '@vueuse/nuxt': ^14.3.0
    chokidar: ^5.0.0
    nuxt: ^4.5.0
    semver: ^7.7.4
    unplugin: ^3.0.0
    vite: ^8.0.0
  dev:
    '@antfu/eslint-config': ^7.7.3
    '@types/node': ^25.9.5
    eslint: ^10.7.0
    eslint-plugin-format: ^2.0.1
    typescript: ^5.9.3
    vue-tsc: ^3.3.8
  frontend:
    '@vueuse/core': ^14.3.0
    pinia: ^3.0.4
    vue: ^3.5.40
  icons:
    '@iconify-json/carbon': ^1.2.19
    '@iconify-json/twemoji': ^1.2.5
onlyBuiltDependencies:
  - '@parcel/watcher'
  - esbuild
  - unrs-resolver
allowBuilds:
  '@parcel/watcher': true
  bcrypt: true
  esbuild: true
  sharp: true
  unrs-resolver: true
  vue-demi: true
